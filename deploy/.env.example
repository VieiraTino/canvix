# [VDS] Copiar para deploy/.env (chmod 600). Nunca vai para git.
POSTGRES_PASSWORD=gerar-com-openssl-rand-hex-24
# Token Bearer do MCP (/api/mcp); tambem e a base da chave dos links de exportacao
CANVIX_MCP_TOKEN=gerar-com-openssl-rand-hex-32
# Utilizador(es) com acesso a /admin
CANVIX_ADMIN_USERS=nome-de-utilizador
# Conta onde ficam os designs e pastas criados pelo MCP
CANVIX_MCP_OWNER=nome-de-utilizador
CANVIX_PUBLIC_URL=https://canva.exemplo.pt
# Unica pasta (da conta CANVIX_MCP_OWNER) onde o MCP pode escrever; vazio = sem restricao
CANVIX_MCP_WRITE_FOLDER=ChatGPT
# Regras do Canvix escritas na app interna (Marketing > Agente). A chave e a
# mesma que AGENT_PROMPT_TOKEN_CANVIX na api. Vazias = sem regras da app.
VDS_PROMPT_URL=https://api.exemplo.pt/api/v1/agent-prompts/canvix
VDS_PROMPT_TOKEN=gerar-com-openssl-rand-hex-32
